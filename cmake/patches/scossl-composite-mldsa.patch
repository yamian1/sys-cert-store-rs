diff --git a/SymCryptProvider/README.md b/SymCryptProvider/README.md
index 1be0c39..4702bb9 100644
--- a/SymCryptProvider/README.md
+++ b/SymCryptProvider/README.md
@@ -73,6 +73,52 @@ Note that just because an algorithm is FIPS certifiable, does not mean it is rec
     - PKCS1, PSS
 - ECDSA (Named curves only)
     - P-192, P-224, P-256, P-384, P-521
+- Composite ML-DSA/ECDSA (the four combinations below)
+
+### Composite ML-DSA
+
+Requires OpenSSL 3.5 or newer and SymCrypt 103.12 or newer.
+
+| Algorithm | OID |
+| --- | --- |
+| MLDSA44-ECDSA-P256-SHA256 | 1.3.6.1.5.5.7.6.40 |
+| MLDSA65-ECDSA-P256-SHA512 | 1.3.6.1.5.5.7.6.45 |
+| MLDSA65-ECDSA-P384-SHA512 | 1.3.6.1.5.5.7.6.46 |
+| MLDSA87-ECDSA-P384-SHA512 | 1.3.6.1.5.5.7.6.49 |
+
+The algorithm name, its `id-` alias, and numeric OID can be used for fetching.
+Use `provider=symcryptprovider` when a specific implementation is required.
+These algorithms and their codecs have `fips=no`; they are not available to a
+`fips=yes` fetch. P-521, Brainpool, RSA, and EdDSA composites are not exposed.
+
+SymCrypt implements key generation, component cryptography, domain separation,
+and composite signature assembly. SCOSSL implements the EVP and ASN.1 adapters.
+No separate composite provider is needed. Keys support generation, duplication,
+public/private import and export, matching, and validation through SymCrypt.
+Raw key getters and the `pub`/`priv` import/export parameters use the SymCrypt
+composite key formats, not the raw format of either individual component.
+
+`EVP_PKEY_sign`/`verify` and one-shot or streaming `EVP_DigestSign`/`Verify`
+operate on the message, not a caller-selected digest. Pass a NULL digest name.
+Streaming uses SymCrypt SHA-256 for the first combination and SHA-512 for the
+other three, then passes that message prehash to SymCrypt's composite API.
+The optional `context-string` parameter accepts at most 255 bytes. An external
+digest, deterministic signing, and caller-supplied generation seeds are not
+supported. Signature size queries return the maximum allocation size; the
+returned signature length can be smaller because ECDSA uses DER encoding.
+
+Supported encodings are SPKI public keys and PKCS#8 private keys, in DER or PEM,
+including encrypted PKCS#8 and human-readable key output. Composite
+AlgorithmIdentifier parameters are absent. The PKCS#8 private-key OCTET STRING
+contains SymCrypt's composite private encoding directly, without the additional
+OCTET STRING used by the pure ML-DSA seed format. The default provider supplies
+the outer PEM/encrypted-PKCS#8 decoding pipeline, so load it alongside SCOSSL.
+The normal OpenSSL X.509, CSR, and encrypted PKCS#12 APIs use these adapters.
+
+This is shared-provider support. It does not add TLS signature-scheme
+negotiation or static embedding into another application. See the
+[tests and interoperability instructions](../test/CompositeMlDsa/README.md),
+including the SymCrypt shared-library unload limitation.
 
 ### Asymmetric Cipher
 - RSA
diff --git a/SymCryptProvider/src/decoder/p_scossl_decode_composite_mldsa.c b/SymCryptProvider/src/decoder/p_scossl_decode_composite_mldsa.c
new file mode 100644
index 0000000..4967b0a
--- /dev/null
+++ b/SymCryptProvider/src/decoder/p_scossl_decode_composite_mldsa.c
@@ -0,0 +1,91 @@
+//
+// Copyright (c) Microsoft Corporation. Licensed under the MIT license.
+//
+
+#include "p_scossl_decode_common.h"
+#include "signature/p_scossl_composite_mldsa.h"
+#include <openssl/proverr.h>
+
+static SCOSSL_COMPOSITE_MLDSA_KEY *composite_decode(
+    SCOSSL_DECODE_CTX *ctx, BIO *bio, SYMCRYPT_COMPOSITE_MLDSA_PARAMS params, BOOL privateKey)
+{
+    const SCOSSL_COMPOSITE_MLDSA_ALG *alg = p_scossl_composite_mldsa_alg(params);
+    SCOSSL_COMPOSITE_MLDSA_KEY *key = NULL;
+    PKCS8_PRIV_KEY_INFO *info = NULL;
+    SUBJECT_PUBKEY_INFO *spki = NULL;
+    const X509_ALGOR *algor = NULL;
+    const ASN1_OBJECT *oid = NULL;
+    const unsigned char *bytes = NULL;
+    int length = 0, parameterType;
+    if (privateKey)
+    {
+        info = d2i_PKCS8_PRIV_KEY_INFO_bio(bio, NULL);
+        if (info == NULL || !PKCS8_pkey_get0(&oid, &bytes, &length, &algor, info))
+            goto cleanup;
+    }
+    else
+    {
+        spki = (SUBJECT_PUBKEY_INFO *)ASN1_item_d2i_bio_ex(
+            p_scossl_decode_subject_pubkey_asn1_item(), bio, NULL, ctx->provctx->libctx, NULL);
+        if (spki == NULL)
+            goto cleanup;
+        algor = spki->x509Alg;
+        X509_ALGOR_get0(&oid, NULL, NULL, algor);
+        bytes = ASN1_STRING_get0_data(spki->subjectPublicKey);
+        length = ASN1_STRING_length(spki->subjectPublicKey);
+    }
+    if (OBJ_obj2nid(oid) != OBJ_txt2nid(alg->oid))
+        goto cleanup; // Another parameter-set decoder may accept this object.
+    X509_ALGOR_get0(NULL, &parameterType, NULL, algor);
+    if (parameterType != V_ASN1_UNDEF || length <= 0 ||
+        (spki != NULL && (spki->subjectPublicKey->flags & 7) != 0))
+    {
+        ERR_raise(ERR_LIB_PROV, PROV_R_BAD_ENCODING);
+        goto cleanup;
+    }
+    key = p_scossl_composite_mldsa_new(params);
+    if (key != NULL && !p_scossl_composite_mldsa_set_encoded(key, privateKey, bytes, (SIZE_T)length))
+    {
+        p_scossl_composite_mldsa_free(key);
+        key = NULL;
+    }
+cleanup:
+    PKCS8_PRIV_KEY_INFO_free(info);
+    ASN1_item_free((ASN1_VALUE *)spki, p_scossl_decode_subject_pubkey_asn1_item());
+    return key;
+}
+
+static int composite_export_object(ossl_unused void *ctx, const void *reference,
+    size_t length, OSSL_CALLBACK *cb, void *arg)
+{
+    SCOSSL_COMPOSITE_MLDSA_KEY *key;
+    if (length != sizeof(key) || reference == NULL || (key = *(SCOSSL_COMPOSITE_MLDSA_KEY **)reference) == NULL)
+    {
+        ERR_raise(ERR_LIB_PROV, ERR_R_PASSED_INVALID_ARGUMENT);
+        return SCOSSL_FAILURE;
+    }
+    return p_scossl_composite_mldsa_export(key, key->hasPrivate ?
+        OSSL_KEYMGMT_SELECT_KEYPAIR : OSSL_KEYMGMT_SELECT_PUBLIC_KEY, cb, arg);
+}
+
+#define DECODE_VARIANT_TYPE(id, sym, name, type, privateKey) \
+    static void *id##_##type##_decode(SCOSSL_DECODE_CTX *ctx, BIO *bio) \
+    { return composite_decode(ctx, bio, SYMCRYPT_COMPOSITE_MLDSA_PARAMS_##sym, privateKey); } \
+    static const SCOSSL_DECODE_KEYTYPE_DESC id##_##type##_desc = { \
+        name, select_##type, (PSCOSSL_DECODE_INTERNAL_FN)id##_##type##_decode, \
+        (OSSL_FUNC_keymgmt_free_fn *)p_scossl_composite_mldsa_free}; \
+    static void *id##_##type##_new(SCOSSL_PROVCTX *provctx) \
+    { return p_scossl_decode_newctx(provctx, &id##_##type##_desc); } \
+    static int id##_##type##_selection(ossl_unused void *provctx, int selection) \
+    { return p_scossl_decode_does_selection(&id##_##type##_desc, selection); } \
+    const OSSL_DISPATCH p_scossl_der_to_##id##_##type##_functions[] = { \
+        {OSSL_FUNC_DECODER_NEWCTX, (void (*)(void))id##_##type##_new}, \
+        {OSSL_FUNC_DECODER_FREECTX, (void (*)(void))p_scossl_decode_freectx}, \
+        {OSSL_FUNC_DECODER_DOES_SELECTION, (void (*)(void))id##_##type##_selection}, \
+        {OSSL_FUNC_DECODER_DECODE, (void (*)(void))p_scossl_decode}, \
+        {OSSL_FUNC_DECODER_EXPORT_OBJECT, (void (*)(void))composite_export_object}, \
+        {0, NULL}};
+#define DECODE_VARIANT(id, sym, name, oid, bits) \
+    DECODE_VARIANT_TYPE(id, sym, name, PrivateKeyInfo, TRUE) \
+    DECODE_VARIANT_TYPE(id, sym, name, SubjectPublicKeyInfo, FALSE)
+SCOSSL_COMPOSITE_MLDSA_VARIANTS(DECODE_VARIANT)
