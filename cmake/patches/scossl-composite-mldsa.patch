+++ b/SymCryptProvider/src/keymgmt/p_scossl_composite_mldsa_keymgmt.c
@@ -0,0 +1,384 @@
+//
+// Copyright (c) Microsoft Corporation. Licensed under the MIT license.
+//
+
+#include "signature/p_scossl_composite_mldsa.h"
+#include <openssl/proverr.h>
+
+#define ALG_INFO(id, sym, name, oid, bits) \
+    {SYMCRYPT_COMPOSITE_MLDSA_PARAMS_##sym, name, oid, bits},
+static const SCOSSL_COMPOSITE_MLDSA_ALG algorithms[] = {
+    SCOSSL_COMPOSITE_MLDSA_VARIANTS(ALG_INFO)
+};
+#undef ALG_INFO
+
+const SCOSSL_COMPOSITE_MLDSA_ALG *p_scossl_composite_mldsa_alg(SYMCRYPT_COMPOSITE_MLDSA_PARAMS params)
+{
+    for (SIZE_T i = 0; i < sizeof(algorithms) / sizeof(algorithms[0]); ++i)
+        if (algorithms[i].params == params)
+            return &algorithms[i];
+    ERR_raise(ERR_LIB_PROV, PROV_R_NOT_SUPPORTED);
+    return NULL;
+}
+
+SCOSSL_STATUS p_scossl_composite_mldsa_register_algorithms(void)
+{
+    for (SIZE_T i = 0; i < sizeof(algorithms) / sizeof(algorithms[0]); ++i)
+    {
+        int nid = OBJ_txt2nid(algorithms[i].oid);
+        if (nid == NID_undef)
+            nid = OBJ_create(algorithms[i].oid, algorithms[i].name, algorithms[i].name);
+        if (nid == NID_undef || !OBJ_add_sigid(nid, NID_undef, nid))
+        {
+            ERR_raise(ERR_LIB_PROV, ERR_R_INIT_FAIL);
+            return SCOSSL_FAILURE;
+        }
+    }
+    return SCOSSL_SUCCESS;
+}
+
+SCOSSL_COMPOSITE_MLDSA_KEY *p_scossl_composite_mldsa_new(SYMCRYPT_COMPOSITE_MLDSA_PARAMS params)
+{
+    const SCOSSL_COMPOSITE_MLDSA_ALG *alg = p_scossl_composite_mldsa_alg(params);
+    SCOSSL_COMPOSITE_MLDSA_KEY *key;
+    if (alg == NULL)
+        return NULL;
+    key = OPENSSL_zalloc(sizeof(*key));
+    if (key == NULL)
+        ERR_raise(ERR_LIB_PROV, ERR_R_MALLOC_FAILURE);
+    else
+        key->alg = alg;
+    return key;
+}
+
+void p_scossl_composite_mldsa_free(SCOSSL_COMPOSITE_MLDSA_KEY *key)
+{
+    if (key != NULL)
+    {
+        if (key->key != NULL)
+            SymCryptCompositeMlDsakeyFree(key->key);
+        OPENSSL_free(key);
+    }
+}
+
+SCOSSL_STATUS p_scossl_composite_mldsa_get_encoded(
+    const SCOSSL_COMPOSITE_MLDSA_KEY *key, BOOL privateKey, PBYTE *bytes, SIZE_T *length)
+{
+    SYMCRYPT_COMPOSITE_MLDSAKEY_FORMAT format = privateKey ?
+        SYMCRYPT_COMPOSITE_MLDSAKEY_FORMAT_PRIVATE_KEY : SYMCRYPT_COMPOSITE_MLDSAKEY_FORMAT_PUBLIC_KEY;
+    SYMCRYPT_ERROR error;
+    *bytes = NULL;
+    *length = 0;
+    if (key == NULL || key->key == NULL || (privateKey && !key->hasPrivate))
+    {
+        ERR_raise(ERR_LIB_PROV, PROV_R_MISSING_KEY);
+        return SCOSSL_FAILURE;
+    }
+    error = SymCryptCompositeMlDsaSizeofKeyFormatFromParams(key->alg->params, format, length);
+    if (error != SYMCRYPT_NO_ERROR)
+        goto symcrypt_error;
+    if ((*bytes = OPENSSL_secure_malloc(*length)) == NULL)
+    {
+        ERR_raise(ERR_LIB_PROV, ERR_R_MALLOC_FAILURE);
+        return SCOSSL_FAILURE;
+    }
+    error = SymCryptCompositeMlDsakeyGetValue(key->key, *bytes, *length, format, 0);
+    if (error == SYMCRYPT_NO_ERROR)
+        return SCOSSL_SUCCESS;
+    OPENSSL_secure_clear_free(*bytes, *length);
+    *bytes = NULL;
+symcrypt_error:
+    SCOSSL_PROV_LOG_SYMCRYPT_ERROR("Composite ML-DSA key export failed", error);
+    return SCOSSL_FAILURE;
+}
+
+SCOSSL_STATUS p_scossl_composite_mldsa_set_encoded(
+    SCOSSL_COMPOSITE_MLDSA_KEY *key, BOOL privateKey, PCBYTE bytes, SIZE_T length)
+{
+    PSYMCRYPT_COMPOSITE_MLDSAKEY imported = SymCryptCompositeMlDsakeyAllocate(key->alg->params);
+    SYMCRYPT_ERROR error;
+    if (imported == NULL)
+    {
+        ERR_raise(ERR_LIB_PROV, ERR_R_MALLOC_FAILURE);
+        return SCOSSL_FAILURE;
+    }
+    error = SymCryptCompositeMlDsakeySetValue(bytes, length, privateKey ?
+        SYMCRYPT_COMPOSITE_MLDSAKEY_FORMAT_PRIVATE_KEY : SYMCRYPT_COMPOSITE_MLDSAKEY_FORMAT_PUBLIC_KEY, 0, imported);
+    if (error != SYMCRYPT_NO_ERROR)
+    {
+        SymCryptCompositeMlDsakeyFree(imported);
+        SCOSSL_PROV_LOG_SYMCRYPT_ERROR("Composite ML-DSA key import failed", error);
+        return SCOSSL_FAILURE;
+    }
+    if (key->key != NULL)
+        SymCryptCompositeMlDsakeyFree(key->key);
+    key->key = imported;
+    key->hasPrivate = privateKey;
+    return SCOSSL_SUCCESS;
+}
+
+static BOOL composite_has(const SCOSSL_COMPOSITE_MLDSA_KEY *key, int selection)
+{
+    return key != NULL &&
+        (!(selection & OSSL_KEYMGMT_SELECT_KEYPAIR) || key->key != NULL) &&
+        (!(selection & OSSL_KEYMGMT_SELECT_PRIVATE_KEY) || key->hasPrivate);
+}
+
+static SCOSSL_COMPOSITE_MLDSA_KEY *composite_dup(const SCOSSL_COMPOSITE_MLDSA_KEY *key, int selection)
+{
+    SCOSSL_COMPOSITE_MLDSA_KEY *copy = p_scossl_composite_mldsa_new(key->alg->params);
+    PBYTE bytes = NULL;
+    SIZE_T length = 0;
+    BOOL privateKey = (selection & OSSL_KEYMGMT_SELECT_PRIVATE_KEY) && key->hasPrivate;
+    if (copy != NULL && key->key != NULL && (selection & OSSL_KEYMGMT_SELECT_KEYPAIR) &&
+        (!p_scossl_composite_mldsa_get_encoded(key, privateKey, &bytes, &length) ||
+         !p_scossl_composite_mldsa_set_encoded(copy, privateKey, bytes, length)))
+    {
+        p_scossl_composite_mldsa_free(copy);
+        copy = NULL;
+    }
+    OPENSSL_secure_clear_free(bytes, length);
+    return copy;
+}
+
+static BOOL composite_match(const SCOSSL_COMPOSITE_MLDSA_KEY *a,
+                            const SCOSSL_COMPOSITE_MLDSA_KEY *b, int selection)
+{
+    PBYTE x = NULL, y = NULL;
+    SIZE_T nx = 0, ny = 0;
+    BOOL equal = FALSE;
+    BOOL privateKey = (selection & OSSL_KEYMGMT_SELECT_PRIVATE_KEY) != 0;
+    if (!composite_has(a, selection) || !composite_has(b, selection) || a->alg != b->alg)
+        return FALSE;
+    if (!(selection & OSSL_KEYMGMT_SELECT_KEYPAIR))
+        return TRUE;
+    if (p_scossl_composite_mldsa_get_encoded(a, privateKey, &x, &nx) &&
+        p_scossl_composite_mldsa_get_encoded(b, privateKey, &y, &ny))
+        equal = nx == ny && CRYPTO_memcmp(x, y, nx) == 0;
+    OPENSSL_secure_clear_free(x, nx);
+    OPENSSL_secure_clear_free(y, ny);
+    return equal;
+}
+
+static BOOL composite_validate(const SCOSSL_COMPOSITE_MLDSA_KEY *key, int selection,
+                               ossl_unused int checktype)
+{
+    SCOSSL_COMPOSITE_MLDSA_KEY *validated;
+    if (!composite_has(key, selection))
+    {
+        ERR_raise(ERR_LIB_PROV, PROV_R_MISSING_KEY);
+        return FALSE;
+    }
+    /* Reimport through SymCrypt to apply its full key-format and key-validity checks. */
+    validated = composite_dup(key, selection);
+    if (validated == NULL)
+        return FALSE;
+    p_scossl_composite_mldsa_free(validated);
+    return TRUE;
+}
+
+SCOSSL_STATUS p_scossl_composite_mldsa_import(
+    SCOSSL_COMPOSITE_MLDSA_KEY *key, int selection, const OSSL_PARAM params[])
+{
+    const OSSL_PARAM *priv = OSSL_PARAM_locate_const(params, OSSL_PKEY_PARAM_PRIV_KEY);
+    const OSSL_PARAM *pub = OSSL_PARAM_locate_const(params, OSSL_PKEY_PARAM_PUB_KEY);
+    BOOL privateKey = (selection & OSSL_KEYMGMT_SELECT_PRIVATE_KEY) && priv != NULL;
+    const OSSL_PARAM *p = privateKey ? priv : pub;
+    const void *bytes = NULL;
+    SIZE_T length = 0, publicLength = 0;
+    PBYTE publicBytes = NULL;
+    SCOSSL_COMPOSITE_MLDSA_KEY *imported = NULL;
+    SCOSSL_STATUS ret = SCOSSL_FAILURE;
+    if (!(selection & OSSL_KEYMGMT_SELECT_KEYPAIR) || p == NULL ||
+        !OSSL_PARAM_get_octet_string_ptr(p, &bytes, &length))
+    {
+        ERR_raise(ERR_LIB_PROV, PROV_R_INVALID_KEY);
+        return SCOSSL_FAILURE;
+    }
+    imported = p_scossl_composite_mldsa_new(key->alg->params);
+    if (imported == NULL || !p_scossl_composite_mldsa_set_encoded(imported, privateKey, bytes, length))
+        goto cleanup;
+    if (privateKey && pub != NULL)
+    {
+        if (!OSSL_PARAM_get_octet_string_ptr(pub, &bytes, &length) ||
+            !p_scossl_composite_mldsa_get_encoded(imported, FALSE, &publicBytes, &publicLength) ||
+            length != publicLength || CRYPTO_memcmp(bytes, publicBytes, length) != 0)
+        {
+            ERR_raise(ERR_LIB_PROV, PROV_R_INVALID_KEY);
+            goto cleanup;
+        }
+    }
+    if (key->key != NULL)
+        SymCryptCompositeMlDsakeyFree(key->key);
+    key->key = imported->key;
+    key->hasPrivate = imported->hasPrivate;
+    imported->key = NULL;
+    ret = SCOSSL_SUCCESS;
+cleanup:
+    OPENSSL_secure_clear_free(publicBytes, publicLength);
+    p_scossl_composite_mldsa_free(imported);
+    return ret;
+}
+
+SCOSSL_STATUS p_scossl_composite_mldsa_export(
+    SCOSSL_COMPOSITE_MLDSA_KEY *key, int selection, OSSL_CALLBACK *cb, void *arg)
+{
+    PBYTE pub = NULL, priv = NULL;
+    SIZE_T pubLen = 0, privLen = 0;
+    OSSL_PARAM params[3];
+    int count = 0;
+    SCOSSL_STATUS ret = SCOSSL_FAILURE;
+    if (!(selection & OSSL_KEYMGMT_SELECT_KEYPAIR) || key->key == NULL)
+    {
+        ERR_raise(ERR_LIB_PROV, PROV_R_MISSING_KEY);
+        return ret;
+    }
+    if (selection & OSSL_KEYMGMT_SELECT_PUBLIC_KEY)
+    {
+        if (!p_scossl_composite_mldsa_get_encoded(key, FALSE, &pub, &pubLen))
+            goto cleanup;
+        params[count++] = OSSL_PARAM_construct_octet_string(OSSL_PKEY_PARAM_PUB_KEY, pub, pubLen);
+    }
+    if ((selection & OSSL_KEYMGMT_SELECT_PRIVATE_KEY) && key->hasPrivate)
+    {
+        if (!p_scossl_composite_mldsa_get_encoded(key, TRUE, &priv, &privLen))
+            goto cleanup;
+        params[count++] = OSSL_PARAM_construct_octet_string(OSSL_PKEY_PARAM_PRIV_KEY, priv, privLen);
+    }
+    if (count == 0)
+    {
+        ERR_raise(ERR_LIB_PROV, PROV_R_NOT_A_PRIVATE_KEY);
+        goto cleanup;
+    }
+    params[count] = OSSL_PARAM_construct_end();
+    ret = cb(params, arg);
+cleanup:
+    OPENSSL_secure_clear_free(pub, pubLen);
+    OPENSSL_secure_clear_free(priv, privLen);
+    return ret;
+}
+
+static const OSSL_PARAM *composite_types(ossl_unused int selection)
+{
+    static const OSSL_PARAM types[] = {
+        OSSL_PARAM_octet_string(OSSL_PKEY_PARAM_PUB_KEY, NULL, 0),
+        OSSL_PARAM_octet_string(OSSL_PKEY_PARAM_PRIV_KEY, NULL, 0), OSSL_PARAM_END};
+    return types;
+}
+
+static const OSSL_PARAM *composite_gettable(ossl_unused void *provctx)
+{
+    static const OSSL_PARAM types[] = {
+        OSSL_PARAM_int(OSSL_PKEY_PARAM_BITS, NULL),
+        OSSL_PARAM_int(OSSL_PKEY_PARAM_SECURITY_BITS, NULL),
+        OSSL_PARAM_size_t(OSSL_PKEY_PARAM_MAX_SIZE, NULL),
+        OSSL_PARAM_utf8_string(OSSL_PKEY_PARAM_MANDATORY_DIGEST, NULL, 0),
+        OSSL_PARAM_octet_string(OSSL_PKEY_PARAM_PUB_KEY, NULL, 0),
+        OSSL_PARAM_octet_string(OSSL_PKEY_PARAM_PRIV_KEY, NULL, 0),
+        OSSL_PARAM_END};
+    return types;
+}
+
+static SCOSSL_STATUS composite_get_key_param(
+    const SCOSSL_COMPOSITE_MLDSA_KEY *key, OSSL_PARAM *param, BOOL privateKey)
+{
+    PBYTE bytes = NULL;
+    SIZE_T length = 0;
+    int ret;
+    if (!p_scossl_composite_mldsa_get_encoded(key, privateKey, &bytes, &length))
+        return SCOSSL_FAILURE;
+    ret = OSSL_PARAM_set_octet_string(param, bytes, length);
+    OPENSSL_secure_clear_free(bytes, length);
+    return ret;
+}
+
+static SCOSSL_STATUS composite_get_params(SCOSSL_COMPOSITE_MLDSA_KEY *key, OSSL_PARAM params[])
+{
+    OSSL_PARAM *p;
+    SIZE_T pubSize, sigSize;
+    if (SymCryptCompositeMlDsaSizeofKeyFormatFromParams(key->alg->params,
+            SYMCRYPT_COMPOSITE_MLDSAKEY_FORMAT_PUBLIC_KEY, &pubSize) != SYMCRYPT_NO_ERROR ||
+        SymCryptCompositeMlDsaSizeofSignatureFromParams(key->alg->params, &sigSize) != SYMCRYPT_NO_ERROR)
+    {
+        ERR_raise(ERR_LIB_PROV, ERR_R_INTERNAL_ERROR);
+        return SCOSSL_FAILURE;
+    }
+    if (((p = OSSL_PARAM_locate(params, OSSL_PKEY_PARAM_BITS)) && !OSSL_PARAM_set_int(p, (int)(pubSize * 8))) ||
+        ((p = OSSL_PARAM_locate(params, OSSL_PKEY_PARAM_SECURITY_BITS)) && !OSSL_PARAM_set_int(p, key->alg->securityBits)) ||
+        ((p = OSSL_PARAM_locate(params, OSSL_PKEY_PARAM_MAX_SIZE)) && !OSSL_PARAM_set_size_t(p, sigSize)) ||
+        ((p = OSSL_PARAM_locate(params, OSSL_PKEY_PARAM_MANDATORY_DIGEST)) && !OSSL_PARAM_set_utf8_string(p, "")) ||
+        ((p = OSSL_PARAM_locate(params, OSSL_PKEY_PARAM_PUB_KEY)) && !composite_get_key_param(key, p, FALSE)) ||
+        ((p = OSSL_PARAM_locate(params, OSSL_PKEY_PARAM_PRIV_KEY)) && !composite_get_key_param(key, p, TRUE)))
+    {
+        ERR_raise(ERR_LIB_PROV, PROV_R_FAILED_TO_SET_PARAMETER);
+        return SCOSSL_FAILURE;
+    }
+    return SCOSSL_SUCCESS;
+}
+
+static void *composite_load(const void *reference, size_t length)
+{
+    SCOSSL_COMPOSITE_MLDSA_KEY *key = NULL;
+    if (length == sizeof(key))
+    {
+        key = *(SCOSSL_COMPOSITE_MLDSA_KEY **)reference;
+        *(SCOSSL_COMPOSITE_MLDSA_KEY **)reference = NULL;
+    }
+    return key;
+}
+
+static void *composite_generate(SCOSSL_COMPOSITE_MLDSA_KEY *gen,
+                               ossl_unused OSSL_CALLBACK *cb, ossl_unused void *arg)
+{
+    SCOSSL_COMPOSITE_MLDSA_KEY *key = p_scossl_composite_mldsa_new(gen->alg->params);
+    SYMCRYPT_ERROR error;
+    if (key == NULL)
+        return NULL;
+    key->key = SymCryptCompositeMlDsakeyAllocate(key->alg->params);
+    if (key->key == NULL)
+    {
+        ERR_raise(ERR_LIB_PROV, ERR_R_MALLOC_FAILURE);
+        goto failure;
+    }
+    error = SymCryptCompositeMlDsakeyGenerate(key->key, 0);
+    if (error != SYMCRYPT_NO_ERROR)
+    {
+        SCOSSL_PROV_LOG_SYMCRYPT_ERROR("Composite ML-DSA generation failed", error);
+        goto failure;
+    }
+    key->hasPrivate = TRUE;
+    return key;
+failure:
+    p_scossl_composite_mldsa_free(key);
+    return NULL;
+}
+
+#define KEYMGMT_VARIANT(id, sym, name, oid, bits) \
+    static void *id##_new(ossl_unused void *provctx) \
+    { return p_scossl_composite_mldsa_new(SYMCRYPT_COMPOSITE_MLDSA_PARAMS_##sym); } \
+    static void *id##_gen_init(void *provctx, int selection, const OSSL_PARAM params[]) \
+    { \
+        if (!(selection & OSSL_KEYMGMT_SELECT_KEYPAIR) || !p_scossl_is_params_empty(params)) \
+        { ERR_raise(ERR_LIB_PROV, PROV_R_NOT_SUPPORTED); return NULL; } \
+        return id##_new(provctx); \
+    } \
+    const OSSL_DISPATCH p_scossl_##id##_keymgmt_functions[] = { \
+        {OSSL_FUNC_KEYMGMT_NEW, (void (*)(void))id##_new}, \
+        {OSSL_FUNC_KEYMGMT_FREE, (void (*)(void))p_scossl_composite_mldsa_free}, \
+        {OSSL_FUNC_KEYMGMT_DUP, (void (*)(void))composite_dup}, \
+        {OSSL_FUNC_KEYMGMT_HAS, (void (*)(void))composite_has}, \
+        {OSSL_FUNC_KEYMGMT_VALIDATE, (void (*)(void))composite_validate}, \
+        {OSSL_FUNC_KEYMGMT_MATCH, (void (*)(void))composite_match}, \
+        {OSSL_FUNC_KEYMGMT_GET_PARAMS, (void (*)(void))composite_get_params}, \
+        {OSSL_FUNC_KEYMGMT_GETTABLE_PARAMS, (void (*)(void))composite_gettable}, \
+        {OSSL_FUNC_KEYMGMT_IMPORT, (void (*)(void))p_scossl_composite_mldsa_import}, \
+        {OSSL_FUNC_KEYMGMT_EXPORT, (void (*)(void))p_scossl_composite_mldsa_export}, \
+        {OSSL_FUNC_KEYMGMT_IMPORT_TYPES, (void (*)(void))composite_types}, \
+        {OSSL_FUNC_KEYMGMT_EXPORT_TYPES, (void (*)(void))composite_types}, \
+        {OSSL_FUNC_KEYMGMT_LOAD, (void (*)(void))composite_load}, \
+        {OSSL_FUNC_KEYMGMT_GEN_INIT, (void (*)(void))id##_gen_init}, \
+        {OSSL_FUNC_KEYMGMT_GEN, (void (*)(void))composite_generate}, \
+        {OSSL_FUNC_KEYMGMT_GEN_CLEANUP, (void (*)(void))p_scossl_composite_mldsa_free}, \
+        {0, NULL}};
+SCOSSL_COMPOSITE_MLDSA_VARIANTS(KEYMGMT_VARIANT)
+#undef KEYMGMT_VARIANT
