+//
+
+#pragma once
+
+#include "p_scossl_base.h"
+
+#define SCOSSL_COMPOSITE_MLDSA_VARIANTS(X) \
+    X(mldsa44_p256, MLDSA44_ECDSA_P256_SHA256, "MLDSA44-ECDSA-P256-SHA256", "1.3.6.1.5.5.7.6.40", 128) \
+    X(mldsa65_p256, MLDSA65_ECDSA_P256_SHA512, "MLDSA65-ECDSA-P256-SHA512", "1.3.6.1.5.5.7.6.45", 192) \
+    X(mldsa65_p384, MLDSA65_ECDSA_P384_SHA512, "MLDSA65-ECDSA-P384-SHA512", "1.3.6.1.5.5.7.6.46", 192) \
+    X(mldsa87_p384, MLDSA87_ECDSA_P384_SHA512, "MLDSA87-ECDSA-P384-SHA512", "1.3.6.1.5.5.7.6.49", 256)
+
+typedef struct
+{
+    SYMCRYPT_COMPOSITE_MLDSA_PARAMS params;
+    const char *name;
+    const char *oid;
+    int securityBits;
+} SCOSSL_COMPOSITE_MLDSA_ALG;
+
+typedef struct
+{
+    const SCOSSL_COMPOSITE_MLDSA_ALG *alg;
+    PSYMCRYPT_COMPOSITE_MLDSAKEY key;
+    BOOL hasPrivate;
+} SCOSSL_COMPOSITE_MLDSA_KEY;
+
+const SCOSSL_COMPOSITE_MLDSA_ALG *p_scossl_composite_mldsa_alg(SYMCRYPT_COMPOSITE_MLDSA_PARAMS params);
+SCOSSL_STATUS p_scossl_composite_mldsa_register_algorithms(void);
+SCOSSL_COMPOSITE_MLDSA_KEY *p_scossl_composite_mldsa_new(SYMCRYPT_COMPOSITE_MLDSA_PARAMS params);
+void p_scossl_composite_mldsa_free(_In_opt_ SCOSSL_COMPOSITE_MLDSA_KEY *key);
+SCOSSL_STATUS p_scossl_composite_mldsa_get_encoded(
+    _In_ const SCOSSL_COMPOSITE_MLDSA_KEY *key, BOOL privateKey,
+    _Out_ PBYTE *bytes, _Out_ SIZE_T *length);
+SCOSSL_STATUS p_scossl_composite_mldsa_set_encoded(
+    _Inout_ SCOSSL_COMPOSITE_MLDSA_KEY *key, BOOL privateKey,
+    _In_reads_bytes_(length) PCBYTE bytes, SIZE_T length);
+SCOSSL_STATUS p_scossl_composite_mldsa_import(
+    _Inout_ SCOSSL_COMPOSITE_MLDSA_KEY *key, int selection, _In_ const OSSL_PARAM params[]);
+SCOSSL_STATUS p_scossl_composite_mldsa_export(
+    _In_ SCOSSL_COMPOSITE_MLDSA_KEY *key, int selection, OSSL_CALLBACK *cb, void *arg);
+
+#define SCOSSL_COMPOSITE_DECLARE(id, sym, name, oid, bits) \
+    extern const OSSL_DISPATCH p_scossl_##id##_keymgmt_functions[]; \
+    extern const OSSL_DISPATCH p_scossl_##id##_signature_functions[];
+SCOSSL_COMPOSITE_MLDSA_VARIANTS(SCOSSL_COMPOSITE_DECLARE)
+#undef SCOSSL_COMPOSITE_DECLARE
