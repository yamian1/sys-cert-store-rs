index 0000000..cd9eca5
--- /dev/null
+++ b/SymCryptProvider/src/signature/p_scossl_composite_mldsa.c
@@ -0,0 +1,316 @@
+//
+// Copyright (c) Microsoft Corporation. Licensed under the MIT license.
+//
+
+#include "p_scossl_composite_mldsa.h"
+#include <openssl/proverr.h>
+
+typedef struct
+{
+    const SCOSSL_COMPOSITE_MLDSA_ALG *alg;
+    SCOSSL_COMPOSITE_MLDSA_KEY *key;
+    int operation;
+    BYTE context[SYMCRYPT_COMPOSITE_MLDSA_CONTEXT_MAX_LENGTH];
+    SIZE_T contextLength;
+    BOOL initialized;
+    union
+    {
+        SYMCRYPT_SHA256_STATE sha256;
+        SYMCRYPT_SHA512_STATE sha512;
+    } hash;
+} SCOSSL_COMPOSITE_SIGNATURE_CTX;
+
+static BOOL uses_sha256(const SCOSSL_COMPOSITE_SIGNATURE_CTX *ctx)
+{
+    return ctx->alg->params == SYMCRYPT_COMPOSITE_MLDSA_PARAMS_MLDSA44_ECDSA_P256_SHA256;
+}
+
+static void signature_free(SCOSSL_COMPOSITE_SIGNATURE_CTX *ctx)
+{
+    OPENSSL_clear_free(ctx, sizeof(*ctx));
+}
+
+static void *signature_dup(const SCOSSL_COMPOSITE_SIGNATURE_CTX *ctx)
+{
+    SCOSSL_COMPOSITE_SIGNATURE_CTX *copy = OPENSSL_zalloc(sizeof(*copy));
+    if (copy == NULL)
+    {
+        ERR_raise(ERR_LIB_PROV, ERR_R_MALLOC_FAILURE);
+        return NULL;
+    }
+    copy->alg = ctx->alg;
+    copy->key = ctx->key;
+    copy->operation = ctx->operation;
+    copy->contextLength = ctx->contextLength;
+    memcpy(copy->context, ctx->context, ctx->contextLength);
+    copy->initialized = ctx->initialized;
+    if (ctx->initialized)
+    {
+        if (uses_sha256(ctx))
+            SymCryptSha256StateCopy(&ctx->hash.sha256, &copy->hash.sha256);
+        else
+            SymCryptSha512StateCopy(&ctx->hash.sha512, &copy->hash.sha512);
+    }
+    return copy;
+}
+
+static SCOSSL_STATUS signature_set_params(SCOSSL_COMPOSITE_SIGNATURE_CTX *ctx, const OSSL_PARAM params[])
+{
+    if (params == NULL)
+        return SCOSSL_SUCCESS;
+    for (const OSSL_PARAM *p = params; p->key != NULL; ++p)
+    {
+        if (strcmp(p->key, OSSL_SIGNATURE_PARAM_CONTEXT_STRING) != 0 ||
+            p->data_type != OSSL_PARAM_OCTET_STRING || p->data_size > sizeof(ctx->context) ||
+            (p->data_size != 0 && p->data == NULL))
+        {
+            ERR_raise(ERR_LIB_PROV, PROV_R_NOT_SUPPORTED);
+            return SCOSSL_FAILURE;
+        }
+    }
+    const OSSL_PARAM *p = OSSL_PARAM_locate_const(params, OSSL_SIGNATURE_PARAM_CONTEXT_STRING);
+    if (p != NULL)
+    {
+        if (p->data_size != 0)
+            memcpy(ctx->context, p->data, p->data_size);
+        ctx->contextLength = p->data_size;
+    }
+    return SCOSSL_SUCCESS;
+}
+
+static const OSSL_PARAM *signature_settable(ossl_unused void *ctx, ossl_unused void *provctx)
+{
+    static const OSSL_PARAM types[] = {
+        OSSL_PARAM_octet_string(OSSL_SIGNATURE_PARAM_CONTEXT_STRING, NULL, 0), OSSL_PARAM_END};
+    return types;
+}
+
+static SCOSSL_STATUS signature_init(SCOSSL_COMPOSITE_SIGNATURE_CTX *ctx,
+    SCOSSL_COMPOSITE_MLDSA_KEY *key, const OSSL_PARAM params[], int operation)
+{
+    ctx->initialized = FALSE;
+    if (key == NULL)
+        key = ctx->key;
+    if (key == NULL || key->key == NULL || key->alg != ctx->alg ||
+        (operation == EVP_PKEY_OP_SIGN && !key->hasPrivate))
+    {
+        ERR_raise(ERR_LIB_PROV, PROV_R_INVALID_KEY);
+        return SCOSSL_FAILURE;
+    }
+    if (!signature_set_params(ctx, params))
+        return SCOSSL_FAILURE;
+    ctx->key = key;
+    ctx->operation = operation;
+    if (uses_sha256(ctx))
+        SymCryptSha256Init(&ctx->hash.sha256);
+    else
+        SymCryptSha512Init(&ctx->hash.sha512);
+    ctx->initialized = TRUE;
+    return SCOSSL_SUCCESS;
+}
+
+static SCOSSL_STATUS sign_init(void *ctx, void *key, const OSSL_PARAM params[])
+{
+    return signature_init(ctx, key, params, EVP_PKEY_OP_SIGN);
+}
+
+static SCOSSL_STATUS verify_init(void *ctx, void *key, const OSSL_PARAM params[])
+{
+    return signature_init(ctx, key, params, EVP_PKEY_OP_VERIFY);
+}
+
+static SCOSSL_STATUS digest_sign_init(void *ctx, const char *md, void *key, const OSSL_PARAM params[])
+{
+    if (md != NULL && md[0] != '\0')
+    {
+        ERR_raise(ERR_LIB_PROV, PROV_R_INVALID_DIGEST);
+        return SCOSSL_FAILURE;
+    }
+    return sign_init(ctx, key, params);
+}
+
+static SCOSSL_STATUS digest_verify_init(void *ctx, const char *md, void *key, const OSSL_PARAM params[])
+{
+    if (md != NULL && md[0] != '\0')
+    {
+        ERR_raise(ERR_LIB_PROV, PROV_R_INVALID_DIGEST);
+        return SCOSSL_FAILURE;
+    }
+    return verify_init(ctx, key, params);
+}
+
+static SCOSSL_STATUS sign_internal(SCOSSL_COMPOSITE_SIGNATURE_CTX *ctx,
+    PBYTE sig, SIZE_T *siglen, SIZE_T capacity, PCBYTE message, SIZE_T length, UINT32 flags)
+{
+    SIZE_T maximum;
+    SYMCRYPT_ERROR error;
+    if (!ctx->initialized || ctx->operation != EVP_PKEY_OP_SIGN || siglen == NULL)
+    {
+        ERR_raise(ERR_LIB_PROV, ERR_R_OPERATION_FAIL);
+        return SCOSSL_FAILURE;
+    }
+    error = SymCryptCompositeMlDsaSizeofSignatureFromParams(ctx->alg->params, &maximum);
+    if (error != SYMCRYPT_NO_ERROR)
+        goto symcrypt_error;
+    *siglen = maximum;
+    if (sig == NULL)
+        return SCOSSL_SUCCESS;
+    if (capacity < maximum)
+    {
+        ERR_raise(ERR_LIB_PROV, PROV_R_OUTPUT_BUFFER_TOO_SMALL);
+        return SCOSSL_FAILURE;
+    }
+    error = SymCryptCompositeMlDsaSign(ctx->key->key, message, length,
+        ctx->context, ctx->contextLength, flags, sig, maximum, siglen);
+    if (error == SYMCRYPT_NO_ERROR)
+        return SCOSSL_SUCCESS;
+symcrypt_error:
+    SCOSSL_PROV_LOG_SYMCRYPT_ERROR("Composite ML-DSA signing failed", error);
+    return SCOSSL_FAILURE;
+}
+
+static SCOSSL_STATUS sign_message(void *ctx, unsigned char *sig, size_t *siglen,
+    size_t capacity, const unsigned char *message, size_t length)
+{
+    return sign_internal(ctx, sig, siglen, capacity, message, length, 0);
+}
+
+static SCOSSL_STATUS verify_internal(SCOSSL_COMPOSITE_SIGNATURE_CTX *ctx,
+    PCBYTE sig, SIZE_T siglen, PCBYTE message, SIZE_T length, UINT32 flags)
+{
+    SYMCRYPT_ERROR error;
+    if (!ctx->initialized || ctx->operation != EVP_PKEY_OP_VERIFY)
+    {
+        ERR_raise(ERR_LIB_PROV, ERR_R_OPERATION_FAIL);
+        return SCOSSL_FAILURE;
+    }
+    error = SymCryptCompositeMlDsaVerify(ctx->key->key, message, length,
+        ctx->context, ctx->contextLength, sig, siglen, flags);
+    if (error == SYMCRYPT_NO_ERROR)
+        return SCOSSL_SUCCESS;
+    if (error != SYMCRYPT_SIGNATURE_VERIFICATION_FAILURE)
+        SCOSSL_PROV_LOG_SYMCRYPT_ERROR("Composite ML-DSA verification failed", error);
+    return SCOSSL_FAILURE;
+}
+
+static SCOSSL_STATUS verify_message(void *ctx, const unsigned char *sig, size_t siglen,
+    const unsigned char *message, size_t length)
+{
+    return verify_internal(ctx, sig, siglen, message, length, 0);
+}
+
+static SCOSSL_STATUS signature_update(SCOSSL_COMPOSITE_SIGNATURE_CTX *ctx, PCBYTE data, SIZE_T length)
+{
+    if (!ctx->initialized)
+    {
+        ERR_raise(ERR_LIB_PROV, ERR_R_OPERATION_FAIL);
+        return SCOSSL_FAILURE;
+    }
+    if (uses_sha256(ctx))
+        SymCryptSha256Append(&ctx->hash.sha256, data, length);
+    else
+        SymCryptSha512Append(&ctx->hash.sha512, data, length);
+    return SCOSSL_SUCCESS;
+}
+
+static SIZE_T signature_digest(const SCOSSL_COMPOSITE_SIGNATURE_CTX *ctx, PBYTE digest)
+{
+    if (uses_sha256(ctx))
+    {
+        SYMCRYPT_SHA256_STATE copy;
+        SymCryptSha256StateCopy(&ctx->hash.sha256, &copy);
+        SymCryptSha256Result(&copy, digest);
+        return SYMCRYPT_SHA256_RESULT_SIZE;
+    }
+    else
+    {
+        SYMCRYPT_SHA512_STATE copy;
+        SymCryptSha512StateCopy(&ctx->hash.sha512, &copy);
+        SymCryptSha512Result(&copy, digest);
+        return SYMCRYPT_SHA512_RESULT_SIZE;
+    }
+}
+
+static SCOSSL_STATUS sign_final(SCOSSL_COMPOSITE_SIGNATURE_CTX *ctx, PBYTE sig, SIZE_T *len, SIZE_T capacity)
+{
+    BYTE digest[SYMCRYPT_SHA512_RESULT_SIZE];
+    SIZE_T length = 0;
+    if (ctx->initialized && sig != NULL)
+        length = signature_digest(ctx, digest);
+    return sign_internal(ctx, sig, len, capacity, digest, length, SYMCRYPT_FLAG_COMPOSITE_MLDSA_PREHASHED);
+}
+
+static SCOSSL_STATUS verify_final(SCOSSL_COMPOSITE_SIGNATURE_CTX *ctx, PCBYTE sig, SIZE_T len)
+{
+    BYTE digest[SYMCRYPT_SHA512_RESULT_SIZE];
+    SIZE_T length = ctx->initialized ? signature_digest(ctx, digest) : 0;
+    return verify_internal(ctx, sig, len, digest, length, SYMCRYPT_FLAG_COMPOSITE_MLDSA_PREHASHED);
+}
+
+static const OSSL_PARAM *signature_gettable(ossl_unused void *ctx, ossl_unused void *provctx)
+{
+    static const OSSL_PARAM types[] = {
+        OSSL_PARAM_octet_string(OSSL_SIGNATURE_PARAM_ALGORITHM_ID, NULL, 0), OSSL_PARAM_END};
+    return types;
+}
+
+static SCOSSL_STATUS signature_get_params(SCOSSL_COMPOSITE_SIGNATURE_CTX *ctx, OSSL_PARAM params[])
+{
+    OSSL_PARAM *p = OSSL_PARAM_locate(params, OSSL_SIGNATURE_PARAM_ALGORITHM_ID);
+    X509_ALGOR *algor = NULL;
+    ASN1_OBJECT *oid = NULL;
+    PBYTE der = NULL;
+    int length;
+    SCOSSL_STATUS ret = SCOSSL_FAILURE;
+    if (p == NULL)
+        return SCOSSL_SUCCESS;
+    algor = X509_ALGOR_new();
+    oid = OBJ_txt2obj(ctx->alg->oid, 1);
+    if (algor == NULL || oid == NULL || !X509_ALGOR_set0(algor, oid, V_ASN1_UNDEF, NULL))
+        goto cleanup;
+    oid = NULL;
+    length = i2d_X509_ALGOR(algor, &der);
+    if (length > 0 && OSSL_PARAM_set_octet_string(p, der, (SIZE_T)length))
+        ret = SCOSSL_SUCCESS;
+cleanup:
+    if (!ret)
+        ERR_raise(ERR_LIB_PROV, PROV_R_FAILED_TO_SET_PARAMETER);
+    ASN1_OBJECT_free(oid);
+    X509_ALGOR_free(algor);
+    OPENSSL_free(der);
+    return ret;
+}
+
+#define SIGNATURE_VARIANT(id, sym, name, oid, bits) \
+    static void *id##_sig_new(ossl_unused void *provctx, ossl_unused const char *propq) \
+    { \
+        SCOSSL_COMPOSITE_SIGNATURE_CTX *ctx = OPENSSL_zalloc(sizeof(*ctx)); \
+        if (ctx == NULL) ERR_raise(ERR_LIB_PROV, ERR_R_MALLOC_FAILURE); \
+        else ctx->alg = p_scossl_composite_mldsa_alg(SYMCRYPT_COMPOSITE_MLDSA_PARAMS_##sym); \
+        return ctx; \
+    } \
+    const OSSL_DISPATCH p_scossl_##id##_signature_functions[] = { \
+        {OSSL_FUNC_SIGNATURE_NEWCTX, (void (*)(void))id##_sig_new}, \
+        {OSSL_FUNC_SIGNATURE_FREECTX, (void (*)(void))signature_free}, \
+        {OSSL_FUNC_SIGNATURE_DUPCTX, (void (*)(void))signature_dup}, \
+        {OSSL_FUNC_SIGNATURE_SIGN_INIT, (void (*)(void))sign_init}, \
+        {OSSL_FUNC_SIGNATURE_VERIFY_INIT, (void (*)(void))verify_init}, \
+        {OSSL_FUNC_SIGNATURE_SIGN_MESSAGE_INIT, (void (*)(void))sign_init}, \
+        {OSSL_FUNC_SIGNATURE_VERIFY_MESSAGE_INIT, (void (*)(void))verify_init}, \
+        {OSSL_FUNC_SIGNATURE_SIGN, (void (*)(void))sign_message}, \
+        {OSSL_FUNC_SIGNATURE_VERIFY, (void (*)(void))verify_message}, \
+        {OSSL_FUNC_SIGNATURE_DIGEST_SIGN_INIT, (void (*)(void))digest_sign_init}, \
+        {OSSL_FUNC_SIGNATURE_DIGEST_VERIFY_INIT, (void (*)(void))digest_verify_init}, \
+        {OSSL_FUNC_SIGNATURE_DIGEST_SIGN, (void (*)(void))sign_message}, \
+        {OSSL_FUNC_SIGNATURE_DIGEST_VERIFY, (void (*)(void))verify_message}, \
+        {OSSL_FUNC_SIGNATURE_DIGEST_SIGN_UPDATE, (void (*)(void))signature_update}, \
+        {OSSL_FUNC_SIGNATURE_DIGEST_VERIFY_UPDATE, (void (*)(void))signature_update}, \
+        {OSSL_FUNC_SIGNATURE_DIGEST_SIGN_FINAL, (void (*)(void))sign_final}, \
+        {OSSL_FUNC_SIGNATURE_DIGEST_VERIFY_FINAL, (void (*)(void))verify_final}, \
+        {OSSL_FUNC_SIGNATURE_SET_CTX_PARAMS, (void (*)(void))signature_set_params}, \
+        {OSSL_FUNC_SIGNATURE_SETTABLE_CTX_PARAMS, (void (*)(void))signature_settable}, \
+        {OSSL_FUNC_SIGNATURE_GET_CTX_PARAMS, (void (*)(void))signature_get_params}, \
+        {OSSL_FUNC_SIGNATURE_GETTABLE_CTX_PARAMS, (void (*)(void))signature_gettable}, \
+        {0, NULL}};
+SCOSSL_COMPOSITE_MLDSA_VARIANTS(SIGNATURE_VARIANT)
+#undef SIGNATURE_VARIANT
