diff --git a/SymCryptProvider/src/encoder/p_scossl_encode_composite_mldsa.c b/SymCryptProvider/src/encoder/p_scossl_encode_composite_mldsa.c
new file mode 100644
index 0000000..b74caf7
--- /dev/null
+++ b/SymCryptProvider/src/encoder/p_scossl_encode_composite_mldsa.c
@@ -0,0 +1,184 @@
+//
+// Copyright (c) Microsoft Corporation. Licensed under the MIT license.
+//
+
+#include "p_scossl_encode_common.h"
+#include "signature/p_scossl_composite_mldsa.h"
+#include <openssl/pkcs12.h>
+#include <openssl/proverr.h>
+
+static PKCS8_PRIV_KEY_INFO *composite_private_info(const SCOSSL_COMPOSITE_MLDSA_KEY *key)
+{
+    PBYTE bytes = NULL, owned = NULL;
+    SIZE_T length = 0;
+    ASN1_OBJECT *oid = NULL;
+    PKCS8_PRIV_KEY_INFO *info = NULL;
+    if (!p_scossl_composite_mldsa_get_encoded(key, TRUE, &bytes, &length))
+        return NULL;
+    oid = OBJ_txt2obj(key->alg->oid, 1);
+    owned = OPENSSL_memdup(bytes, length);
+    info = PKCS8_PRIV_KEY_INFO_new();
+    if (oid == NULL || owned == NULL || info == NULL ||
+        !PKCS8_pkey_set0(info, oid, 0, V_ASN1_UNDEF, NULL, owned, (int)length))
+    {
+        ERR_raise(ERR_LIB_PROV, ASN1_R_ENCODE_ERROR);
+        PKCS8_PRIV_KEY_INFO_free(info);
+        info = NULL;
+        ASN1_OBJECT_free(oid);
+        OPENSSL_clear_free(owned, length);
+    }
+    OPENSSL_secure_clear_free(bytes, length);
+    return info;
+}
+
+static int composite_private_encode(SCOSSL_ENCODE_CTX *ctx, BIO *out,
+    const SCOSSL_COMPOSITE_MLDSA_KEY *key, ossl_unused int selection,
+    OSSL_PASSPHRASE_CALLBACK *cb, void *arg)
+{
+    PKCS8_PRIV_KEY_INFO *info = composite_private_info(key);
+    X509_SIG *encrypted = NULL;
+    char password[PEM_BUFSIZE];
+    SIZE_T passwordLength = 0;
+    int ret = 0;
+    if (info == NULL)
+        return SCOSSL_FAILURE;
+    if (ctx->cipher != NULL)
+    {
+        if (cb == NULL || !cb(password, sizeof(password), &passwordLength, NULL, arg) ||
+            passwordLength > sizeof(password))
+        {
+            ERR_raise(ERR_LIB_PROV, PROV_R_UNABLE_TO_GET_PASSPHRASE);
+            goto cleanup;
+        }
+        encrypted = PKCS8_encrypt_ex(-1, ctx->cipher, password, (int)passwordLength,
+            NULL, 0, 0, info, ctx->provctx->libctx, NULL);
+        if (encrypted == NULL)
+            goto cleanup;
+        ret = ctx->desc->outFormat == SCOSSL_ENCODE_PEM ?
+            PEM_write_bio_PKCS8(out, encrypted) : i2d_PKCS8_bio(out, encrypted);
+    }
+    else
+    {
+        ret = ctx->desc->outFormat == SCOSSL_ENCODE_PEM ?
+            PEM_write_bio_PKCS8_PRIV_KEY_INFO(out, info) : i2d_PKCS8_PRIV_KEY_INFO_bio(out, info);
+    }
+cleanup:
+    if (!ret)
+        ERR_raise(ERR_LIB_PROV, ASN1_R_ENCODE_ERROR);
+    OPENSSL_cleanse(password, sizeof(password));
+    X509_SIG_free(encrypted);
+    PKCS8_PRIV_KEY_INFO_free(info);
+    return ret;
+}
+
+static int composite_encrypted_encode(SCOSSL_ENCODE_CTX *ctx, BIO *out,
+    const SCOSSL_COMPOSITE_MLDSA_KEY *key, int selection, OSSL_PASSPHRASE_CALLBACK *cb, void *arg)
+{
+    if (ctx->cipher == NULL)
+    {
+        ERR_raise(ERR_LIB_PROV, PROV_R_MISSING_CIPHER);
+        return SCOSSL_FAILURE;
+    }
+    return composite_private_encode(ctx, out, key, selection, cb, arg);
+}
+
+static int composite_public_encode(SCOSSL_ENCODE_CTX *ctx, BIO *out,
+    const SCOSSL_COMPOSITE_MLDSA_KEY *key, ossl_unused int selection,
+    ossl_unused OSSL_PASSPHRASE_CALLBACK *cb, ossl_unused void *arg)
+{
+    PBYTE bytes = NULL, owned = NULL;
+    SIZE_T length = 0;
+    X509_PUBKEY *info = NULL;
+    ASN1_OBJECT *oid = NULL;
+    int ret = 0;
+    if (!p_scossl_composite_mldsa_get_encoded(key, FALSE, &bytes, &length))
+        return SCOSSL_FAILURE;
+    info = X509_PUBKEY_new();
+    oid = OBJ_txt2obj(key->alg->oid, 1);
+    owned = OPENSSL_memdup(bytes, length);
+    if (info == NULL || oid == NULL || owned == NULL ||
+        !X509_PUBKEY_set0_param(info, oid, V_ASN1_UNDEF, NULL, owned, (int)length))
+        goto cleanup;
+    oid = NULL;
+    owned = NULL;
+    ret = ctx->desc->outFormat == SCOSSL_ENCODE_PEM ?
+        PEM_write_bio_X509_PUBKEY(out, info) : i2d_X509_PUBKEY_bio(out, info);
+cleanup:
+    if (!ret)
+        ERR_raise(ERR_LIB_PROV, ASN1_R_ENCODE_ERROR);
+    OPENSSL_secure_clear_free(bytes, length);
+    OPENSSL_free(owned);
+    ASN1_OBJECT_free(oid);
+    X509_PUBKEY_free(info);
+    return ret;
+}
+
+static int composite_text_encode(ossl_unused SCOSSL_ENCODE_CTX *ctx, BIO *out,
+    const SCOSSL_COMPOSITE_MLDSA_KEY *key, int selection,
+    ossl_unused OSSL_PASSPHRASE_CALLBACK *cb, ossl_unused void *arg)
+{
+    PBYTE bytes = NULL;
+    SIZE_T length = 0;
+    BOOL privateKey = (selection & OSSL_KEYMGMT_SELECT_PRIVATE_KEY) != 0;
+    int ret = 0;
+    if (!p_scossl_composite_mldsa_get_encoded(key, privateKey, &bytes, &length))
+        return SCOSSL_FAILURE;
+    if (BIO_printf(out, "%s %s key:\n", key->alg->name, privateKey ? "Private" : "Public") > 0)
+        ret = p_scossl_encode_write_key_bytes(bytes, length, out);
+    if (!ret)
+        ERR_raise(ERR_LIB_PROV, ERR_R_OPERATION_FAIL);
+    OPENSSL_secure_clear_free(bytes, length);
+    return ret;
+}
+
+#define ENCODE_DESCRIPTOR(type, format, selection, fn) \
+    static const SCOSSL_ENCODE_KEYTYPE_DESC desc_##type##_##format = { \
+        selection, SCOSSL_ENCODE_##format, (PSCOSSL_ENCODE_INTERNAL_FN)fn}; \
+    static void *new_##type##_##format(SCOSSL_PROVCTX *provctx) \
+    { return p_scossl_encode_newctx(provctx, &desc_##type##_##format); } \
+    static int select_##type##_##format(ossl_unused void *provctx, int selectionValue) \
+    { return p_scossl_encode_does_selection(&desc_##type##_##format, selectionValue); }
+
+ENCODE_DESCRIPTOR(PrivateKeyInfo, DER, OSSL_KEYMGMT_SELECT_PRIVATE_KEY, composite_private_encode)
+ENCODE_DESCRIPTOR(PrivateKeyInfo, PEM, OSSL_KEYMGMT_SELECT_PRIVATE_KEY, composite_private_encode)
+ENCODE_DESCRIPTOR(EncryptedPrivateKeyInfo, DER, OSSL_KEYMGMT_SELECT_PRIVATE_KEY, composite_encrypted_encode)
+ENCODE_DESCRIPTOR(EncryptedPrivateKeyInfo, PEM, OSSL_KEYMGMT_SELECT_PRIVATE_KEY, composite_encrypted_encode)
+ENCODE_DESCRIPTOR(SubjectPublicKeyInfo, DER, OSSL_KEYMGMT_SELECT_PUBLIC_KEY, composite_public_encode)
+ENCODE_DESCRIPTOR(SubjectPublicKeyInfo, PEM, OSSL_KEYMGMT_SELECT_PUBLIC_KEY, composite_public_encode)
+ENCODE_DESCRIPTOR(text, TEXT, OSSL_KEYMGMT_SELECT_KEYPAIR, composite_text_encode)
+
+#define ENCODE_DISPATCH(id, type, suffix, format) \
+    const OSSL_DISPATCH p_scossl_##id##_to_##type##_##suffix##_functions[] = { \
+        {OSSL_FUNC_ENCODER_NEWCTX, (void (*)(void))new_##type##_##format}, \
+        {OSSL_FUNC_ENCODER_FREECTX, (void (*)(void))p_scossl_encode_freectx}, \
+        {OSSL_FUNC_ENCODER_SET_CTX_PARAMS, (void (*)(void))p_scossl_encode_set_ctx_params}, \
+        {OSSL_FUNC_ENCODER_SETTABLE_CTX_PARAMS, (void (*)(void))p_scossl_encode_settable_ctx_params}, \
+        {OSSL_FUNC_ENCODER_DOES_SELECTION, (void (*)(void))select_##type##_##format}, \
+        {OSSL_FUNC_ENCODER_ENCODE, (void (*)(void))p_scossl_encode}, \
+        {OSSL_FUNC_ENCODER_IMPORT_OBJECT, (void (*)(void))id##_encoder_import}, \
+        {OSSL_FUNC_ENCODER_FREE_OBJECT, (void (*)(void))p_scossl_composite_mldsa_free}, \
+        {0, NULL}};
+
+#define ENCODE_VARIANT(id, sym, name, oid, bits) \
+    static void *id##_encoder_import(ossl_unused void *ctx, int selection, const OSSL_PARAM params[]) \
+    { \
+        SCOSSL_COMPOSITE_MLDSA_KEY *key = p_scossl_composite_mldsa_new(SYMCRYPT_COMPOSITE_MLDSA_PARAMS_##sym); \
+        if (key != NULL && !p_scossl_composite_mldsa_import(key, selection, params)) \
+        { p_scossl_composite_mldsa_free(key); key = NULL; } \
+        return key; \
+    } \
+    ENCODE_DISPATCH(id, PrivateKeyInfo, der, DER) \
+    ENCODE_DISPATCH(id, PrivateKeyInfo, pem, PEM) \
+    ENCODE_DISPATCH(id, EncryptedPrivateKeyInfo, der, DER) \
+    ENCODE_DISPATCH(id, EncryptedPrivateKeyInfo, pem, PEM) \
+    ENCODE_DISPATCH(id, SubjectPublicKeyInfo, der, DER) \
+    ENCODE_DISPATCH(id, SubjectPublicKeyInfo, pem, PEM) \
+    const OSSL_DISPATCH p_scossl_##id##_to_text_functions[] = { \
+        {OSSL_FUNC_ENCODER_NEWCTX, (void (*)(void))new_text_TEXT}, \
+        {OSSL_FUNC_ENCODER_FREECTX, (void (*)(void))p_scossl_encode_freectx}, \
+        {OSSL_FUNC_ENCODER_DOES_SELECTION, (void (*)(void))select_text_TEXT}, \
+        {OSSL_FUNC_ENCODER_ENCODE, (void (*)(void))p_scossl_encode}, \
+        {OSSL_FUNC_ENCODER_IMPORT_OBJECT, (void (*)(void))id##_encoder_import}, \
+        {OSSL_FUNC_ENCODER_FREE_OBJECT, (void (*)(void))p_scossl_composite_mldsa_free}, \
+        {0, NULL}};
+SCOSSL_COMPOSITE_MLDSA_VARIANTS(ENCODE_VARIANT)
diff --git a/SymCryptProvider/src/keymgmt/p_scossl_composite_mldsa_keymgmt.c b/SymCryptProvider/src/keymgmt/p_scossl_composite_mldsa_keymgmt.c
